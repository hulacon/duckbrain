+    # duckbrain patch (patches/qsiprep/README.md): a session with opposing-PE
+    # pairs on two axes (AP/PA and LR/RL) yields two eddy groups whose names both
+    # reduce to the session name, because get_concatenated_bids_name keeps only
+    # the entities common to a group and each pair has two dir- values.
+    # workflows/base.py keys a dict on that name, so the second group overwrote
+    # the first and one pair was never preprocessed, silently. Give each
+    # colliding group a distinct name and map it to the shared name, which is
+    # the destination --distortion-group-merge reads. Non-colliding groups are
+    # returned exactly as before.
+    name_counts = defaultdict(int)
+    for group in eddy_dwi_groups:
+        name_counts[group['concatenated_bids_name']] += 1
+
+    concatenation_grouping = {}
+    for group in eddy_dwi_groups:
+        shared_name = group['concatenated_bids_name']
+        if name_counts[shared_name] > 1:
+            group['concatenated_bids_name'] = _distinct_group_name(group, shared_name)
+        concatenation_grouping[group['concatenated_bids_name']] = shared_name
+
+    if len(concatenation_grouping) != len(eddy_dwi_groups):
+        raise ValueError(
+            'duckbrain grouping patch could not give every eddy group a distinct name: '
+            f'{sorted(g["concatenated_bids_name"] for g in eddy_dwi_groups)}'
+        )
+    if concatenation_grouping != {name: name for name in concatenation_grouping}:
+        config.loggers.workflow.info(
+            'duckbrain grouping patch: colliding eddy groups renamed:\n'
+            f'{pprint.pformat(concatenation_grouping, indent=2, width=120)}'
+        )
+    return eddy_dwi_groups, concatenation_grouping
+
+
