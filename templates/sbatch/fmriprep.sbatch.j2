#!/bin/bash
#SBATCH --job-name=fmriprep_{{ subject }}{% if session %}_{{ session }}{% endif %}
#SBATCH --partition={{ slurm.partition }}
#SBATCH --time={{ slurm.time }}
#SBATCH --cpus-per-task={{ slurm.cpus }}
#SBATCH --mem={{ slurm.memory }}
#SBATCH --output={{ paths.log_dir }}/fmriprep_%j.out
{% if slurm.email %}#SBATCH --mail-user={{ slurm.email }}
#SBATCH --mail-type={{ slurm.mail_type }}
{% endif %}{% if slurm.account %}#SBATCH --account={{ slurm.account }}
{% endif %}
echo "=== fMRIPrep: sub-{{ subject }}{% if session %} ses-{{ session }}{% endif %} ==="
echo "Started: $(date)"
echo "Node: $(hostname)"

{# Paths carry `| sh` — one interpolation, one shell argument. Expansions of the
   variables assigned here need their own quotes ("$WORK_DIR"), since the filter
   only protects the assignment, not every later use of it.

   Neither resource number below is a config value of its own. `--nprocs` reads
   the same `slurm.cpus` as the `#SBATCH --cpus-per-task` directive above —
   fMRIPrep documents it as the budget across all processes, which is what the
   allocation is — and `mem_gb` is derived from `#SBATCH --mem` by
   config.tool_mem_gb, which is where that reason lives. Nothing here may spell
   a ceiling of its own: two independently-set numbers on one script is the bug
   both rules exist to prevent.

   `--omp-nthreads` is deliberately NOT passed. fMRIPrep sets it to
   `min(nprocs - 1, 8)`, so it is already a function of the one input we have,
   and pinning it here would freeze a number the tool derives correctly.

   `extra_flags` is the one deliberate exception: it is a shell fragment the
   operator supplies and it must word-split (`--use-syn-sdc --fd-spike-threshold
   0.5` is three arguments), so it is the one unquoted field in this template.

   Every note about the command belongs HERE, above it. A Jinja comment parked
   between two continued lines still emits its own newline, and a blank line
   after a trailing backslash ends the command right there — which is how the
   anat-reuse job (and only that job, since the comment sat inside the
   `derivatives` branch) shipped without `--skip-bids-validation --notrack` and
   failed BIDS validation on every session past the first. Pinned by
   test_no_comment_breaks_a_line_continuation. #}
# WORK_DIR is qualified by project, step and unit (config.unit_work_dir): it is
# node-local, and every study's subject labels restart at 01, so a bare
# /tmp/sub-<label> is one nipype cache shared by every project with that label
# that lands on this node. It is stable across attempts on purpose — a re-run
# after a walltime kill resumes from what the killed attempt left.
WORK_DIR={{ work_dir | sh }}
OUTPUT_DIR={{ output_dir | sh }}

# TemplateFlow home and tmpdir are per-job (under WORK_DIR): a shared home on the
# node-local FS races when two fMRIPrep jobs land on the same node and both
# initialize the skeleton cache (FileExistsError on tpl-* extraction).
export SINGULARITYENV_TEMPLATEFLOW_HOME="$WORK_DIR/templateflow"
export SINGULARITY_TMPDIR="$WORK_DIR/tmp"
mkdir -p "$WORK_DIR" "$SINGULARITYENV_TEMPLATEFLOW_HOME" "$SINGULARITY_TMPDIR"

# Marks when THIS attempt began, so the cleanup below can tell a crash this run
# wrote from one an earlier attempt left in the same derivative.
ATTEMPT_STAMP="$WORK_DIR/.duckbrain-attempt"
touch "$ATTEMPT_STAMP"

# Output dir is bind-mounted below; Singularity requires the source to pre-exist.
# When --derivatives points at the output dir itself (the anat-reuse case) it is
# NOT bound a second time read-only: that self-overlap makes Singularity drop one
# of the two binds, and if it ever dropped the read-write one fMRIPrep could not
# write its outputs.
mkdir -p {{ output_dir | sh }}

singularity run {{ container_flags }} \
  -B {{ (bids_dir ~ ":" ~ bids_dir ~ ":ro") | sh }} \
  -B {{ (output_dir ~ ":" ~ output_dir) | sh }} \
  -B "$WORK_DIR:$WORK_DIR" \
  -B {{ (fs_license_dir ~ ":" ~ fs_license_dir ~ ":ro") | sh }} \
{% if derivatives and derivatives != output_dir %}  -B {{ (derivatives ~ ":" ~ derivatives ~ ":ro") | sh }} \
{% endif %}  {{ container_path | sh }} \
  {{ bids_dir | sh }} {{ output_dir | sh }} participant \
  --participant-label {{ subject | sh }} \
{% if filter_file %}  --bids-filter-file {{ filter_file | sh }} \
{% endif %}  --output-spaces {{ output_spaces | map("string") | map("sh") | join(' ') }} \
  --fs-license-file {{ fs_license | sh }} \
  --nprocs {{ slurm.cpus }} \
  --mem-mb {{ mem_gb * 1024 }} \
  -w "$WORK_DIR" \
{% if anat_only %}  --anat-only \
{% endif %}{% if derivatives %}  --derivatives {{ derivatives | sh }} \
{% endif %}{% if fs_no_resume is defined and fs_no_resume %}  --fs-no-resume \
{% endif %}{% if extra_flags is defined and extra_flags %}  {{ extra_flags }} \
{% endif %}  --skip-bids-validation --notrack

EXIT_CODE=$?
echo "Finished: $(date)"
echo "Exit code: $EXIT_CODE"

# Node-local scratch is nobody's to keep once a run is genuinely done: nothing
# downstream reads it (the FreeSurfer tree lives under the output dir, not here),
# and nothing else ever removes it, so it accumulates on the node until an
# eviction nobody asked for. Removed only when the run looks finished, so a
# failure keeps its nipype cache for the next attempt to resume from and for
# whoever has to read it. A walltime kill keeps it by construction — the shell
# never reaches this line.
#
# "Looks finished" is NOT the exit code alone. fMRIPrep runs some nodes on
# nipype's master thread, where a crash is discarded before the not-run report,
# so the workflow prints success and the process returns 0 having produced almost
# nothing (consistency._check_tool_crashes has the mechanism). The crash file
# the tool writes is the artifact that disagrees; deleting the work dir on exit 0
# would be trusting exactly the signal that lies. -newer the attempt stamp
# because a crash record outlives the attempt that wrote it.
if [ "$EXIT_CODE" -eq 0 ] &&
   [ -z "$(find "$OUTPUT_DIR" -maxdepth 2 -name 'crash-*' -newer "$ATTEMPT_STAMP" 2>/dev/null)" ]; then
  rm -rf "$WORK_DIR"
fi

exit $EXIT_CODE
