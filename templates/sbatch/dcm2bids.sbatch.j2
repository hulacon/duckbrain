#!/bin/bash
#SBATCH --job-name=dcm2bids_{{ subject }}{% if session %}_{{ session }}{% endif %}
#SBATCH --partition={{ slurm.partition }}
#SBATCH --time={{ slurm.time }}
#SBATCH --cpus-per-task={{ slurm.cpus }}
#SBATCH --mem={{ slurm.memory }}
#SBATCH --output={{ paths.log_dir }}/dcm2bids_%j.out
{% if slurm.email %}#SBATCH --mail-user={{ slurm.email }}
#SBATCH --mail-type={{ slurm.mail_type }}
{% endif %}{% if slurm.account %}#SBATCH --account={{ slurm.account }}
{% endif %}
echo "=== dcm2bids: sub-{{ subject }}{% if session %} ses-{{ session }}{% endif %} ==="
echo "Started: $(date)"
echo "Node: $(hostname)"

{# Every interpolation below is ONE shell argument, so every one carries `| sh`.
   A bind spec is built and quoted whole: source:destination:mode is a single
   argument to singularity, not three.

   force needs BOTH flags: --force_dcm2bids overwrites the temporary dcm2niix
   output, --clobber overwrites the BIDS output. Without the second, dcm2bids
   skips every destination file that already exists and exits 0, so a reconvert
   silently kept the old sidecars. See build_dcm2bids_command for the full note.

   Every note about the command belongs HERE, above it. A Jinja comment parked
   between two continued lines still emits its own newline, and a blank line
   after a trailing backslash ends the command right there — which is how the
   note above, when it sat next to the flags it describes, stopped those flags
   from ever reaching dcm2bids. Pinned by
   test_no_comment_breaks_a_line_continuation.

   BIDS validation is duckbrain's OWN call below, not dcm2bids' --bids_validate,
   and it needs --ignoreSymlinks. Ingestion symlinks each session's DICOMs in at
   sourcedata/sub-XX/dicom; the validator follows that symlink and recurses using
   the TARGET path against an unchanged dataset root, so every file's relativePath
   escapes the dataset (`./../../gpfs/projects/…/*.dcm`) and the ignore test — whose
   defaults already include /sourcedata — can never match it. No .bidsignore entry
   can fix that, and dcm2bids has no passthrough for the flag. Measured on
   dwi_eyeball: 2605 files and 2540 NOT_INCLUDED errors before, 66 files and zero
   after, in 0.98 s. Full account in core/validation.py, whose argv this must
   match exactly — pinned by
   test_the_sbatch_validator_call_is_the_one_core_validation_builds.

   The validation call is ONE unbroken line on purpose: a line with no
   continuation cannot be truncated by the hazard above. And it sits AFTER
   `EXIT_CODE=$?`, so dcm2bids' status stays the job's status. Validation
   reports, it never blocks — the doctrine core/checks.py states, and what
   --bids_validate already did in practice, since dcm2bids ran the validator
   under a Popen wrapper that never inspected the return code. #}
singularity run {{ container_flags }} \
  -B {{ (dicom_dir ~ ":" ~ dicom_dir ~ ":ro") | sh }} \
  -B {{ (paths.bids_dir ~ ":" ~ paths.bids_dir) | sh }} \
  -B {{ (config_json_dir ~ ":" ~ config_json_dir ~ ":ro") | sh }} \
  {{ container_path | sh }} \
  -d {{ dicom_dir | sh }} \
  -p {{ subject | sh }} \
{% if session %}  -s {{ session | sh }} \
{% endif %}  -c {{ config_json | sh }} \
  -o {{ paths.bids_dir | sh }} \
  {% if force %}--force_dcm2bids --clobber{% endif %}

EXIT_CODE=$?
{% if bids_validate %}
echo
echo "=== BIDS validation ==="
singularity exec {{ container_flags }} -B {{ (paths.bids_dir ~ ":" ~ paths.bids_dir) | sh }} {{ container_path | sh }} bids-validator --ignoreSymlinks {{ paths.bids_dir | sh }}
echo "bids-validator exit: $?"
{% endif %}
echo "Finished: $(date)"
echo "Exit code: $EXIT_CODE"
exit $EXIT_CODE
